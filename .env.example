# Copy this file to .env and fill in your values
# These must also be set as Environment Variables in your Vercel project settings

# Backend API URL (e.g. your Railway/Render/Heroku deployed backend)
VITE_API_URL=https://your-backend.com/api/v1

# Supabase
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_k_xxxxx

# ImageKit
VITE_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your-id
VITE_IMAGEKIT_PUBLIC_KEY=public_xxxxx

# Stripe
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxx
