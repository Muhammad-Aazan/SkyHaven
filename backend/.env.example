# ============================================================
# SkyHeaven Backend — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/skyhaven

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d

# Cloudflare R2 (S3-compatible storage)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_BUCKET_NAME=skyhaven-vault
R2_PUBLIC_URL=https://your-bucket.r2.dev

# Email (Nodemailer — use Gmail App Password or SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="SkyHeaven <noreply@skyhaven.io>"

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# OTP expiry in minutes
OTP_EXPIRY_MINUTES=10

# Storage Plans (bytes)
FREE_QUOTA=26843545600
PRO_QUOTA=2199023255552
BUSINESS_QUOTA=10995116277760

# Stripe Payments
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
